<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Product>SchafVPN</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>SchafVPN</AssemblyName>
    <RootNamespace>SchafVPN</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.2.0</Version>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!--
      EmbedProfile: profile.txt varsa exe'ye gömülür (kur.bat ile kişisel derleme).
      Yayın (release.ps1) her zaman EmbedProfile=false ile derler: dağıtılan exe'de profil OLMAZ.
    -->
    <EmbedProfile Condition="'$(EmbedProfile)' == ''">true</EmbedProfile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="core\xray.exe" LogicalName="xray.exe" />
    <EmbeddedResource Include="core\wintun.dll" LogicalName="wintun.dll" />
    <EmbeddedResource Include="ui\index.html" LogicalName="index.html" />
  </ItemGroup>
  <ItemGroup Condition="'$(EmbedProfile)' == 'true' And Exists('profile.txt')">
    <EmbeddedResource Include="profile.txt" LogicalName="profile.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <Target Name="CheckEmbeddedFiles" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('core\xray.exe') Or !Exists('core\wintun.dll')" Text="core\xray.exe veya core\wintun.dll bulunamadi. Once scripts\get-xray.ps1 calistir." />
  </Target>

</Project>
